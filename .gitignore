# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Credentials and secrets
env.txt
.env
.env.*
*.token
*.secret
token.json
gdrive_credentials.json
gdrive_token.json
*-service-account.json

# Logs
/logs/
*.log
*.log.*

# Generated reports and exports
/reports/
/backtest_results/
/stock-data/*
# Patch scripts
patch*.py
patch_*.py

# Calendars (user populated)
nse_holidays.json
high_impact_events.json

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build
build/
dist/
*.egg-info/

# Temp
*.tmp
*.bak
*.orig


# ============================================================
# DATABASES
# ============================================================

# Ignore database files directly inside /data/
# Example: data/nifty_algo_v3.db
/data/*

/output/*
*.pid

patch.py
# Ignore SQLite temporary/locking files everywhere
*.db-wal
*.db-shm
*.db-journal


# Misc: ignore by default (notes, credentials); allow registrar scripts only
/Misc/**
!/Misc/register_*.ps1

# Google / GCP client secrets (never commit)
**/gen-lang-client-*.json

