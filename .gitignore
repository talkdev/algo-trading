# ============================================================
# STOCK-DATA WORKING FILES
# ============================================================

# Cache, logs and generated reports
/stock-data/cache/
/stock-data/logs/
/stock-data/reports/

# Deployment/runtime databases
/stock-data/*.sqlite3
/stock-data/*.lock

# Environment/configuration files
/stock-data/env.txt*

# Generated NAV CSV files only.
# Other files under stock-data/nav/ remain trackable.
/stock-data/nav/*.csv

# ============================================================
# LARGE DATABASE FILES
# GitHub rejects individual files larger than 100 MB.
# Keep data/ tracked except for explicitly listed large files.
# ============================================================

# Primary database and crash/split copies
/data/nifty_algo_v3.db
/data/nifty_algo_v3.db.*

# Recovery dump
/data/recovery/from_corrupt.db

# Oversized per-day database shards
/data/per_day/nifty_algo_2026-09-23.db
/data/per_day/nifty_algo_2026-09-24.db
/data/per_day/nifty_algo_2026-09-25.db
/data/per_day/nifty_algo_2026-09-28.db
