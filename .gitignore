# ============================================================
# DATABASES
# ============================================================

# Ignore database files directly inside /data/
# Example: data/nifty_algo_v3.db
/data/*.db
/data/*.py
/data/*.txt
/data/_roi_runs/*/*.json
/data/_hunt_runs/*/*.json
/data/_live_dumps/*/*.json
/data/*.json
/data/*.out
/data/*.err
/data/baseline/cache/*
/output/*
*.pid
/tests/

patch.py
# Ignore SQLite temporary/locking files everywhere
*.db-wal
*.db-shm
*.db-journal

# IMPORTANT:
# Keep the smaller daily databases under /data/per_day/
# even though /data/*.db is ignored.
!/data/per_day/
!/data/per_day/*.db
# Oversized daily DB (GitHub 100MB limit) - keep local only
data/per_day/nifty_algo_2026-09-23.db

# Misc: ignore by default (notes, credentials); allow registrar scripts only
/Misc/**
!/Misc/register_*.ps1

# Google / GCP client secrets (never commit)
**/gen-lang-client-*.json

